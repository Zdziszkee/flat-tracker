# Copy to .env.local to override defaults. Everything here is optional:
# with no .env.local the app uses ./dev.db, http://localhost:3000, and
# generates a dev auth secret.

# Database URL for SQLite (default: dev.db)
DATABASE_URL="dev.db"

# Better Auth configuration (default base URL: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate: `bunx --bun @better-auth/cli secret`

# Mapbox public token (client-side). Create one at https://account.mapbox.com
# and restrict it to your app domain in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=pk.xxxx

# Which powiaty the RCN refresh imports. Default "malopolska" (the region the
# app shows, ~21 packages); "pl" makes the hourly refresh cover all 380
# (~5.3 GB of downloads). A one-off whole-country load is better done with
# `bun run import:rcn-gugik:all`.
# RCN_GUGIK_SCOPE=malopolska

# Re-import a powiat only if it last ran more than this many hours ago.
# RCN_GUGIK_CADENCE_HOURS=20
